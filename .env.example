# URL base de la futura API REST (backend + MySQL).
VITE_API_URL=http://localhost:3000/api

# true  -> utiliza los datos ficticios de src/data (modo demostración)
# false -> utiliza la API REST definida en VITE_API_URL
VITE_USE_MOCKS=true

# Latencia simulada (ms) para las respuestas ficticias.
VITE_MOCK_DELAY=400
